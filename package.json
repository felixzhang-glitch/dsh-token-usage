{
  "name": "dsh-token-usage",
  "version": "0.2.3",
  "description": "Token usage dashboard: host aggregation endpoint over session logs plus a settings-section UI with overview, by-date, and by-model breakdowns",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
